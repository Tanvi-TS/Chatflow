<div class="flex h-full flex-col">

    <!-- Header -->
    <div class="border-b border-slate-200 px-6 py-5">

        <div class="flex items-center justify-between">

            <div>
                <h1 class="text-xl font-bold text-indigo-700">
                    ChatFlow
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Your conversations
                </p>
            </div>

            <a
                href="/profile"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-700 transition"
            >
                <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            </a>

        </div>

    </div>


    <!-- Search -->
    <div class="px-5 py-4">

        <div class="relative">

            <svg
                class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"
                />
            </svg>

            <input
                type="text"
                id="userSearch"
                placeholder="Search people..."
                class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 pl-10 pr-4 text-sm text-slate-700 outline-none focus:border-indigo-600 focus:bg-white focus:ring-1 focus:ring-indigo-600"
            >

        </div>

    </div>


    <!-- People -->
    <div class="flex-1 overflow-y-auto px-3 pb-4">

        <div class="px-3 pb-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                People
            </p>
        </div>


        <% if (users && users.length > 0) { %>

            <div id="userList" class="space-y-1">

                <% users.forEach(otherUser => { %>

                    <a
                        href="/chat/<%= otherUser._id %>"
                        class="user-item flex items-center gap-3 rounded-lg px-3 py-3 transition hover:bg-indigo-50"
                        data-name="<%= otherUser.name.toLowerCase() %>"
                    >

                        <!-- Avatar -->
                        <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-semibold text-white">
                            <%= otherUser.name
                                ? otherUser.name.charAt(0).toUpperCase()
                                : "U"
                            %>
                        </div>


                        <!-- User Info -->
                        <div class="min-w-0 flex-1">

                            <h3 class="truncate text-sm font-semibold text-slate-800">
                                <%= otherUser.name %>
                            </h3>

                            <p class="mt-0.5 text-xs text-slate-500">
                                Start a conversation
                            </p>

                        </div>

                    </a>

                <% }) %>

            </div>

        <% } else { %>

            <div class="px-3 py-10 text-center">

                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">

                    <svg
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M8 10h.01M12 10h.01M16 10h.01M9 16h6m5-4a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"
                        />
                    </svg>

                </div>

                <p class="mt-3 text-sm font-medium text-slate-700">
                    No people found
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    There are no other users to chat with yet.
                </p>

            </div>

        <% } %>

    </div>


    <!-- Footer -->
    <div class="border-t border-slate-200 p-4">

        <div class="flex items-center justify-between">

            <a
                href="/profile"
                class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-slate-50"
            >

                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-xs font-semibold text-white">
                    <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
                </div>

                <div class="min-w-0">

                    <p class="truncate text-sm font-semibold text-slate-800">
                        <%= user.name %>
                    </p>

                    <p class="text-xs text-slate-500">
                        My profile
                    </p>

                </div>

            </a>


            <a
                href="/settings"
                class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-indigo-600 transition"
                title="Settings"
            >

                <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.4-3.5a7.8 7.8 0 0 0-.1-1.1l2-1.5-2-3.4-2.4 1a8.4 8.4 0 0 0-1.9-1.1L14.7 3h-4l-.4 2.4a8.4 8.4 0 0 0-1.9 1.1L6 5.5 4 8.9l2 1.5a7.8 7.8 0 0 0-.1 1.1 7.8 7.8 0 0 0 .1 1.1l-2 1.5 2 3.4 2.4-1a8.4 8.4 0 0 0 1.9 1.1l.4 2.4h4l.4-2.4a8.4 8.4 0 0 0 1.9-1.1l2.4 1 2-3.4-2-1.5c.1-.4.1-.7.1-1.1Z"
                    />
                </svg>

            </a>

        </div>

    </div>

</div>


<script>

    const searchInput = document.getElementById("userSearch");
    const userItems = document.querySelectorAll(".user-item");

    if (searchInput) {

        searchInput.addEventListener("input", function () {

            const searchValue = this.value.toLowerCase().trim();

            userItems.forEach(item => {

                const name = item.dataset.name;

                if (name.includes(searchValue)) {
                    item.classList.remove("hidden");
                } else {
                    item.classList.add("hidden");
                }

            });

        });

    }

</script>