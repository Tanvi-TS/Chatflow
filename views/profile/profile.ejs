<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6">

    <div class="mx-auto max-w-2xl">

        <!-- Header -->

        <div class="mb-6">

            <h1 class="text-2xl font-bold text-slate-800">
                Profile
            </h1>

            <p class="mt-1 text-sm text-slate-500">
                Manage your ChatFlow profile.
            </p>

        </div>


        <!-- Profile Card -->

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="flex flex-col items-center text-center">

                <!-- Avatar -->

                <div
                    class="flex h-24 w-24 items-center justify-center rounded-full bg-indigo-600 text-3xl font-bold text-white"
                >
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>


                <!-- Name -->

                <h2 class="mt-5 text-xl font-semibold text-slate-800">
                    <%= user.name %>
                </h2>


                <!-- Email -->

                <p class="mt-1 text-sm text-slate-500">
                    <%= user.email %>
                </p>


                <!-- Edit Button -->

                <a
                    href="/profile/edit"
                    class="mt-6 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700"
                >
                    Edit Profile
                </a>

            </div>

        </div>


        <!-- Back -->

        <div class="mt-5">

            <a
                href="/dashboard"
                class="text-sm font-medium text-indigo-600 hover:text-indigo-700"
            >
                ← Back to Dashboard
            </a>

        </div>

    </div>

</div>