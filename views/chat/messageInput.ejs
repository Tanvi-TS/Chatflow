<div class="bg-white border-t border-slate-200 p-4">

    <form id="messageForm">

        <div class="flex gap-3">

            <input
                id="messageInput"
                type="text"
                name="text"
                placeholder="Type a message..."
                autocomplete="off"
                class="flex-1 rounded-lg border border-slate-300 px-4 py-3 text-sm outline-none focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100"
                required
            >

            <button
                type="submit"
                class="rounded-lg bg-indigo-600 px-6 py-3 text-sm font-medium text-white transition hover:bg-indigo-700"
            >
                Send
            </button>

        </div>

    </form>

</div>