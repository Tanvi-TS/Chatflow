<div class="border-t border-slate-200 bg-white px-5 py-4">

    <form
        action="/message/<%= chat._id %>"
        method="POST"
        class="flex items-center gap-3"
    >

        <!-- Message Input -->
        <input
            type="text"
            name="text"
            placeholder="Write a message..."
            autocomplete="off"
            class="min-w-0 flex-1 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-indigo-600 focus:bg-white focus:ring-1 focus:ring-indigo-600"
            required
        >


        <!-- Send Button -->
        <button
            type="submit"
            class="flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >

            <span>
                Send
            </span>

            <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 12h14M13 6l6 6-6 6"
                />
            </svg>

        </button>

    </form>

</div>