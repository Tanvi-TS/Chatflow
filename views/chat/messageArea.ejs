<div
    id="messageArea"
    class="h-full overflow-y-auto bg-slate-50 px-5 py-6"
>

    <div id="messagesList" class="space-y-3">

        <% if (messages && messages.length > 0) { %>

            <% messages.forEach(message => { %>

                <%- include("./messageBubble", { message, user }) %>

            <% }) %>

        <% } else { %>

            <%- include("./emptyChat", { receiver }) %>

        <% } %>

    </div>

</div>