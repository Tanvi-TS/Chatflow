<div
    class="h-screen flex flex-col bg-slate-50"
    data-chat-id="<%= chat._id %>"
    data-user-id="<%= user._id.toString() %>"
    data-receiver-id="<%= receiver._id.toString() %>"
>
    <!-- Chat Header -->
    <%- include("./chatHeader") %>

    <!-- Messages -->
    <div class="flex-1 min-h-0">
        <%- include("./messageArea") %>
    </div>

    <!-- Message Input -->
    <%- include("./messageInput") %>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/socket.js"></script>